# Copy to n8n/.env (git-ignored). Use the same values as in Convex (npx convex env set …).
# Convex → n8n webhook signatures (Convex: N8N_WEBHOOK_SECRET)
LENDLOOP_N8N_WEBHOOK_SECRET=
# n8n → Convex request signatures (Convex: LENDLOOP_INBOUND_SECRET)
LENDLOOP_INBOUND_SECRET=
# Convex HTTP actions URL, e.g. https://<deployment>.convex.site (local: http://host.docker.internal:3211)
LENDLOOP_CONVEX_SITE_URL=
# Encrypts credentials stored in n8n
N8N_ENCRYPTION_KEY=
